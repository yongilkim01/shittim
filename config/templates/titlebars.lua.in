-- Managed by Shittim. Optional compositor decorations, not a QML overlay.
hl.on("hyprland.start", function() hl.exec_cmd(__LOAD__) end)
if not (hl.plugin and hl.plugin.hyprbars and hl.plugin.hyprbars.add_button) then return end
hl.config({
    plugin = { hyprbars = {
        enabled = true, bar_height = @titlebarHeight@, bar_color = "rgb(@background@)",
        col = { text = "rgb(@textPrimary@)" }, bar_text_size = @titlebarText@,
        bar_text_font = "@fontMono@", bar_text_align = "left",
        bar_part_of_window = true, bar_precedence_over_border = false,
        bar_padding = @titlebarPadding@, bar_button_padding = @titlebarButtonGap@, bar_buttons_alignment = "right",
        bar_blur = false, icon_on_hover = false,
        on_double_click = __MAXIMIZE__,
    } },
})
-- Right to left; actions use the existing Shittim window controller.
-- Standard symbols select vector paths in the Shittim renderer; stock hyprbars uses its system font.
hl.plugin.hyprbars.add_button({ bg_color = "rgba(00000000)", fg_color = "rgb(@accent@)", size = @windowButtonSize@, icon = "×", action = __CLOSE__ })
hl.plugin.hyprbars.add_button({ bg_color = "rgba(00000000)", fg_color = "rgb(@accent@)", size = @windowButtonSize@, icon = "□", action = __MAXIMIZE__ })
hl.plugin.hyprbars.add_button({ bg_color = "rgba(00000000)", fg_color = "rgb(@accent@)", size = @windowButtonSize@, icon = "−", action = __HIDE__ })
-- Apps without a custom headerbar can use the compositor titlebar on next launch.
hl.env("GTK_CSD", "0")
