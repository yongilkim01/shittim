# Managed by Shittim: HUD lock screen generated by scripts/desktop-tool.py.
# Authentication stays with hyprlock and its PAM file (/etc/pam.d/hyprlock); Shittim never reads the password.
general {
    hide_cursor = true
    ignore_empty_input = true
    fail_timeout = 2000
}

animations {
    enabled = false
}

background {
    monitor =
    path = @ROOT@/assets/wallpapers/shittim-city.png
    color = rgb(020f15)
    blur_passes = 0
}

image {
    monitor =
    path = @ROOT@/assets/branding/shittim-emblem.png
    size = 64
    rounding = 0
    border_size = 0
    position = 0, -112
    halign = center
    valign = top
}

label {
    monitor =
    text = <span letter_spacing="6144">SHITTIM</span>
    color = rgb(00d9f5)
    font_size = 19
    font_family = D2Coding
    position = 0, -180
    halign = center
    valign = top
}

label {
    monitor =
    text = <span letter_spacing="4096">$TIME</span>
    color = rgb(d5f8ff)
    font_size = 92
    font_family = D2Coding
    position = 0, -228
    halign = center
    valign = top
}

label {
    monitor =
    text = cmd[update:60000] date '+<span letter_spacing="5120">%Y.%m.%d</span>'
    color = rgb(76aebc)
    font_size = 15
    font_family = D2Coding
    position = 0, -342
    halign = center
    valign = top
}

image {
    monitor =
    path = @ROOT@/assets/lock/card.png
    size = 132
    rounding = 0
    border_size = 0
    position = 0, 122
    halign = center
    valign = bottom
}

label {
    monitor =
    text = cmd[update:0] printf '<span letter_spacing="4096">%s</span>' "$(id -un | tr '[:lower:]' '[:upper:]')"
    color = rgb(d5f8ff)
    font_size = 15
    font_family = D2Coding
    position = 0, 210
    halign = center
    valign = bottom
}

input-field {
    monitor =
    size = 313, 42
    outline_thickness = 1
    rounding = 0
    inner_color = rgba(020f15e6)
    outer_color = rgba(08798bff)
    font_color = rgb(d5f8ff)
    check_color = rgba(00d9f5ff)
    fail_color = rgba(ff637eff)
    capslock_color = rgba(ffc56bff)
    font_family = D2Coding
    placeholder_text = 비밀번호 입력
    check_text = 확인 중…
    fail_text = 비밀번호가 올바르지 않습니다 · $ATTEMPTS회
    fade_on_empty = false
    dots_size = 0.22
    dots_spacing = 0.35
    dots_center = false
    position = -22, 150
    halign = center
    valign = bottom
}

label {
    monitor =
    text = cmd[update:5000] /usr/bin/bash @ROOT_SH@/scripts/lock-status.sh
    color = rgb(d5f8ff)
    font_size = 15
    font_family = D2Coding
    position = 0, 48
    halign = center
    valign = bottom
}
